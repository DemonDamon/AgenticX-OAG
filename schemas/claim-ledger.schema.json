{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DemonDamon/agenticx-oag/schemas/claim-ledger.schema.json",
  "title": "OAG Claim Ledger",
  "description": "A provenance-first ledger of claims produced by ontology-aware deep research.",
  "type": "object",
  "required": ["schema_version", "research_question", "claims"],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "research_question": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "claim": {
      "type": "object",
      "required": ["claim_id", "text", "status", "entities", "evidence"],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim:[A-Za-z0-9._-]+$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["supported", "partially_supported", "inferred", "contested", "unverified"]
        },
        "entities": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^entity:[A-Za-z0-9._-]+$"}
        },
        "relations": {
          "type": "array",
          "items": {"type": "string", "pattern": "^rel:[A-Za-z0-9._-]+$"}
        },
        "scope": {
          "type": "object",
          "properties": {
            "time_range": {"type": "string"},
            "geography": {"type": "string"},
            "conditions": {"type": "string"}
          },
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "reasoning": {
          "type": "string",
          "description": "Required in practice for inferred claims; records the bounded reasoning chain."
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "limitations": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["source_id", "url", "locator", "source_type", "publication_date", "accessed_at", "strength"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^src:[A-Za-z0-9._-]+$"},
        "url": {"type": "string", "format": "uri"},
        "locator": {"type": "string", "description": "Page, section, table, timestamp or quoted passage locator."},
        "source_type": {"enum": ["primary", "official", "peer_reviewed", "dataset", "secondary", "other"]},
        "publication_date": {"type": "string", "format": "date"},
        "accessed_at": {"type": "string", "format": "date"},
        "strength": {"enum": ["high", "medium", "low"]},
        "excerpt": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
